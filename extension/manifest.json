{
  "manifest_version": 3,
  "name": "ScamShield — scam-risk checker",
  "version": "1.0.0",
  "description": "Highlight scam indicators in any suspicious message or link before you act. Runs the ScamShield rule engine entirely on-device.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check this page with ScamShield"
  },
  "icons": {
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  }
}
